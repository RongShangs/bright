<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00000000">

    <LinearLayout
        android:id="@+id/dialogCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/bg_dialog"
        android:orientation="horizontal"
        android:padding="12dp"
        android:elevation="8dp"
        android:baselineAligned="false">

        <!-- Left Panel: Info (50% Width) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_weight="1"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="背屏控制"
                android:textColor="#333333"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1A000000"
                android:layout_marginVertical="6dp" />

            <TextView
                android:id="@+id/takeoverStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="当前为系统控制"
                android:textColor="#666666"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- 3x2 Grid for Brightness Info -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:columnCount="2"
                android:rowCount="3"
                android:orientation="horizontal">

                <!-- Row 1: Target -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="目标"
                    android:textColor="#999999"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/targetVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="----"
                    android:textColor="#333333"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Row 2: Current -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="当前"
                    android:textColor="#999999"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/currentVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="2dp"
                    android:text="----"
                    android:textColor="#1E88E5"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Row 3: Max -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="最大"
                    android:textColor="#999999"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/maxVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="2dp"
                    android:text="----"
                    android:textColor="#999999"
                    android:textSize="11sp" />
            </GridLayout>

            <TextView
                android:id="@+id/rootStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Root: 未授权"
                android:textColor="#FF5252"
                android:textSize="10sp"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/releasePage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="发布页"
                android:textColor="#1E88E5"
                android:textSize="10sp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/developerLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="酷安@戎Shangs"
                android:textColor="#999999"
                android:textSize="10sp"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- Right Container (50% Width) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginStart="8dp">

            <!-- Middle Panel: Slider -->
            <brightnesslock.rongshangs.top.ui.VerticalBrightnessSlider
                android:id="@+id/brightnessSlider"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <!-- Right Column: AOD Toggle + Restore Button -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/aodToggleBtn"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_panel"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/aodText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="AOD\n已关"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/restoreBtn"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_panel"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="还原\n系统\n控制"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
